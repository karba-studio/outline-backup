// outline-backup - annotated configuration template.
//
// `outline-backup init` generates this file for you by asking questions. This
// copy exists so you can see every option and edit by hand afterwards.
// Comments are allowed in the real config.json too.
//
// ─────────────────────────────────────────────────────────────────────────────
// WHERE THE ENCRYPTION KEY GOES, AND WHAT IT PROTECTS
//
// There is NO key in this file. Every secret is referenced by the NAME of an
// environment variable, and the values live in `secrets.env` next to it
// (mode 0600). So this file is safe to commit; secrets.env never is.
//
// Each destination has its own encryption key: the value of the variable named
// in its `passwordEnv`, e.g.
//
//     secrets.env:
//       OMB_DEST_B2_KARBA_PASSWORD=<32 random bytes, generated by `init`>
//
// WHERE encryption happens: on THIS machine, before anything leaves it.
// The storage provider only ever receives ciphertext - contents, file names
// and directory structure included.
//
// WHAT it protects against: someone getting into the storage account, or
// stealing the bucket. That is the threat it is for, and it covers it fully.
//
// WHAT it does NOT protect against: someone who already controls the machine
// running the backups. They can read secrets.env, so they can read the
// backups. That is unavoidable - the machine has to be able to decrypt in
// order to restore - and it is worth being clear about rather than pretending
// otherwise.
//
// If you lose a password, the backups in that destination are unreadable
// permanently. There is no recovery path; that is what makes the encryption
// meaningful. Put it in a password manager the moment `init` prints it.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,

  // How to reach the running Outline stack. Postgres is dumped THROUGH its
  // container, so no local pg_dump is needed and versions can never disagree.
  "docker": {
    "composeProject": "outline",
    // Optional but recommended: a scheduled task runs from an unpredictable
    // working directory, and this makes the lookup independent of it.
    "composeFile": "C:\\server\\outline\\docker-compose.yml",
    "network": "outline_default",
    "postgresService": "postgres",
    "postgresSuperuser": "postgres"
  },

  // The object store holding attachments, shared by every instance below.
  // Plain S3 - MinIO, AWS S3, Wasabi, R2, Garage all work. An instance can
  // override this with its own "storage" block if it lives somewhere else.
  "storage": {
    "endpoint": "https://s3.example.com",
    "region": "us-east-1",
    // true for MinIO and most self-hosted stores; false for AWS S3.
    "pathStyle": true
  },

  // ───────────────────────────────────────────────────────────────────────────
  // WHERE BACKUPS GO
  //
  // Destinations are declared once here and referenced by name from instances.
  // That makes both shapes possible:
  //
  //   one wiki  -> several destinations   (a second provider, plus a NAS)
  //   several wikis -> one destination    (they share a bucket)
  //
  // Repositories are always namespaced by instance name, so two wikis sharing
  // one destination still get separate repositories and never interleave
  // snapshots. Note that they DO share that destination's encryption password;
  // if that is not acceptable, give them two destination entries pointing at
  // the same bucket with different prefixes and different passwords.
  // ───────────────────────────────────────────────────────────────────────────
  "destinations": {
    // A Backblaze B2 account used only by the private wiki.
    "b2-karba": {
      "kind": "b2",                       // b2 | s3 | sftp | local | rclone
      "bucket": "example-kb-backup",
      // "prefix": "wiki",                // optional subdirectory
      "keyIdEnv": "OMB_DEST_B2_KARBA_KEY_ID",
      "appKeyEnv": "OMB_DEST_B2_KARBA_APP_KEY",
      // >>> THE ENCRYPTION KEY FOR THIS DESTINATION <<<
      "passwordEnv": "OMB_DEST_B2_KARBA_PASSWORD"
    },

    // A completely separate B2 account for the business wiki: a compromised
    // login or a billing problem on one side cannot touch the other.
    "b2-amator": {
      "kind": "b2",
      "bucket": "example-business-backup",
      "keyIdEnv": "OMB_DEST_B2_AMATOR_KEY_ID",
      "appKeyEnv": "OMB_DEST_B2_AMATOR_APP_KEY",
      "passwordEnv": "OMB_DEST_B2_AMATOR_PASSWORD"
    },

    // A local disk or NAS, shared by BOTH wikis. Still encrypted.
    "nas": {
      "kind": "local",
      "path": "/Volumes/backup/outline",
      "passwordEnv": "OMB_DEST_NAS_PASSWORD",
      // A destination may keep a shorter history than the instance asks for.
      // A cheap local disk rarely needs years of it.
      "retention": { "keepDaily": 7 }
    }

    // Other kinds:
    //   "kind": "s3",     "endpoint": "https://...", "bucket": "...", keyIdEnv, appKeyEnv
    //   "kind": "sftp",   "path": "user@host:/srv/backups"
    //   "kind": "rclone", "path": "gdrive:backups/outline"
    //
    // rclone is the escape hatch: it speaks to around seventy services, so
    // Google Drive, OneDrive, Dropbox, pCloud, Azure and the rest work without
    // this tool knowing anything about them. Run `rclone config` once, then
    // name the remote here.
  },

  // One entry per Outline instance.
  "instances": [
    {
      "name": "private",                    // used on the command line
      "description": "kb.example.com",      // free text, for the manifest
      "database": "outline_private",        // Postgres database for this wiki
      "bucket": "outline-private",          // its bucket on the store above

      // Names of the variables in secrets.env holding this instance's
      // object-store key. Scope the key to this bucket only - `check` will
      // fail if it can read another instance's bucket.
      "s3AccessKeyEnv": "OMB_PRIVATE_S3_KEY",
      "s3SecretKeyEnv": "OMB_PRIVATE_S3_SECRET",

      // Both wikis normally share one Keycloak database. Copying it into each
      // backup costs a few hundred kB and makes either one restorable on its
      // own, without the other.
      "keycloakDatabase": "keycloak",

      // Outline encrypts some stored tokens with SECRET_KEY. Including .env
      // makes a restore seamless instead of merely possible. It ends up inside
      // the encrypted snapshot, so listing it here exposes nothing.
      "envFile": "C:\\server\\outline\\.env",

      // Anything else worth carrying along, copied verbatim.
      "extraFiles": [],

      // TWO copies of this wiki: offsite and local.
      "backupTo": ["b2-karba", "nas"],

      // How much history to keep. Applies to every destination above unless
      // that destination overrides it. 0 (or omitted) disables a rule;
      // all-zero keeps everything forever.
      //
      // keepLast is a plain cap - "never more than N backups". Everything else
      // is a CALENDAR rule: with two runs a day, keepDaily 7 still means seven
      // days, not three and a half.
      //
      // Note what this counts: restorable points in time, not files in the
      // bucket. The destination is a deduplicated repository, so the bucket
      // holds hundreds of opaque encrypted packs, and `outline-backup
      // snapshots` is what shows you the N backups you configured. The payoff
      // is size: four separate archives of a 2 GB wiki cost 8 GB, four
      // deduplicated snapshots of it cost a little over 2 GB.
      "retention": {
        // "keepLast": 4,                   // e.g. exactly four, nothing else
        // "keepHourly": 24,
        "keepDaily": 30,
        "keepWeekly": 8,
        "keepMonthly": 12,
        "keepYearly": 3
      }
    },

    {
      "name": "business",
      "description": "wiki.example.com",
      "database": "outline_business",
      "bucket": "outline-business",
      "s3AccessKeyEnv": "OMB_BUSINESS_S3_KEY",
      "s3SecretKeyEnv": "OMB_BUSINESS_S3_SECRET",
      "keycloakDatabase": "keycloak",
      "envFile": "C:\\server\\outline\\.env",

      // Its own B2 account, and the same NAS the private wiki uses.
      "backupTo": ["b2-amator", "nas"],

      "retention": {
        "keepDaily": 14,
        "keepWeekly": 8,
        "keepMonthly": 12,
        "keepYearly": 3
      }
    }
  ],

  // When the `agent` command runs backups.
  // mode: "daily" | "weekly" | "monthly" | "manual"
  //   daily   - every day at each time in "times"
  //   weekly  - on "dayOfWeek"
  //   monthly - on "dayOfMonth" (1-28, so it exists in February)
  //   manual  - never on its own; use this when Task Scheduler, cron or a
  //             systemd timer calls `backup` instead
  //
  // Examples:
  //   twice a day          "mode": "daily",   "times": ["03:00", "15:00"]
  //   Saturdays 08:00 UTC  "mode": "weekly",  "dayOfWeek": "saturday",
  //                        "times": ["08:00"], "timezone": "UTC"
  //   first of the month   "mode": "monthly", "dayOfMonth": 1, "times": ["02:00"]
  "schedule": {
    "mode": "daily",
    "times": ["03:00"],        // several entries = several runs a day
    // "dayOfWeek": "sunday",
    // "dayOfMonth": 1,
    "timezone": "Europe/Warsaw" // IANA name; empty = this machine's local time
  },

  // Scratch space for assembling one backup. Emptied after every run.
  // Needs room for one instance's database dump plus its attachments.
  "stagingDir": "C:\\server\\omb\\staging"
}
